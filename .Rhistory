"exdat_pm"
data("exdat_pm")
force(exdat_pm)
View(exdat_pm)
exdat_pm <- exdat_pm |> mutate(erf_shape = "log_linear") |>
select(-calculation_method)
View(exdat_pm)
exdat_pm <- exdat_pm |> relocate(erf_shape, .after = relative_risk_upper)
save(exdat_pm, file = "data/exdat_pm.rda")
