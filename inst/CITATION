# Dynamic citation for R users
pkg_name <- "healthiar"

# Read DESCRIPTION
desc <- as.list(utils::packageDescription(pkg_name))

# Parse Authors@R
authors <- eval(parse(text = desc$`Authors@R`))

# Identify main authors and contributors
main_authors <- authors[vapply(authors$role, function(x) any(x %in% c("aut", "cre")), logical(1))]
contributors <- authors[vapply(authors$role, function(x) "ctb" %in% x, logical(1))]

# Helper: format names
format_names <- function(persons) {
  sapply(persons, function(p) paste(na.omit(c(p$given, p$family)), collapse = " "))
}

# Build contributor text
contributors_text <- if (length(contributors) > 0) {
  paste("Contributors:", paste(format_names(contributors), collapse = ", "))
} else {
  NULL
}

# Use full title from DESCRIPTION
full_title <- paste0("healthiar: ", desc$Title)

# Create citation
bibentry(
  bibtype  = "Manual",
  title    = full_title,
  author   = main_authors,
  year     = format(Sys.Date(), "%Y"),
  note     = paste(c(contributors_text, paste0("R package version: ", desc$Version)), collapse = ". "),
  url      = "https://github.com/SwissTPH/healthiar"
)
